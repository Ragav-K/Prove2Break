# Copy this file to .env and fill in real local values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://your-user:your-password@localhost:5433/prove2break

# --- JWT Auth ---
JWT_SECRET_KEY=your-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Object Storage (S3-compatible) ---
S3_BUCKET_NAME=your-bucket-name-here
S3_ENDPOINT_URL=https://your-s3-endpoint-here
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-secret-key-here

# --- AI Provider (behind AIService abstraction) ---
AI_PROVIDER=your-ai-provider-here
AI_API_KEY=your-ai-api-key-here
AI_MODEL_NAME=your-model-name-here

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:8000

# --- Study material storage (Phase 4 local-disk fallback until S3/MinIO is wired up) ---
STORAGE_DIR=./storage/materials
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_PDF_PAGES=500
